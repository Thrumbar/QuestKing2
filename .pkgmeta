package-as: QuestKing

manual-changelog:
  filename: QuestKing/CONSOLIDATED_CHANGELOG.md
  markup-type: markdown

move-folders:
  QuestKing/QuestKing: QuestKing

enable-nolib-creation: no
enable-toc-creation: no

# Preserve the supplied loader manifests exactly.
plain-copy:
  - '*.toc'

ignore:
  - .github
  - .release
  - docs
  - tools
  - tests
  - '*.zip'
  - '*.7z'
  - '*.rar'
  - README-MAINTAINER.md
  - QuestKingSounds
  - QuestKing/DIGANOSTIC_OPTIONS_README.md
  - QuestKing/RELEASE_READINESS_REPORT.md
  - QuestKing/SUPPLIED_PATCH_VALIDATION.md
